# Copy to .env.local (dev) or set on the server / in docker-compose.

# Live screenshots for the "Live client platforms" cards.
# Free key: Google Cloud console > enable "PageSpeed Insights API" > Credentials > API key.
PAGESPEED_API_KEY=

# Alternative provider (paid). Used only when PAGESPEED_API_KEY is empty.
MICROLINK_API_KEY=

# Public origin for canonical URLs, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://alexkemboi.dev
